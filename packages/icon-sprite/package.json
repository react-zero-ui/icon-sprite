{
  "name": "@react-zero-ui/icon-sprite",
  "version": "0.4.2",
  "private": false,
  "description": "Generate a single SVG sprite containing only the icons you used (Lucide + Tabler + custom). Lucid to SVG sprite solution for React.",
  "keywords": [
    "react",
    "icons",
    "lucide",
    "tabler",
    "svg",
    "sprite",
    "nextjs",
    "vite",
    "zero-runtime",
    "tree-shaking",
    "lucid-to-sprite",
    "svg-to-sprite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-zero-ui/icon-sprite.git",
    "directory": "packages/icon-sprite"
  },
  "license": "MIT",
  "author": "Austinserb <austin@zero-ui.dev>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./*": "./*"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zero-icons": "dist/command.js"
  },
  "files": [
    "assets/catalog.json",
    "assets/licenses",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "generate": "node scripts/generate-icons.ts",
    "prepack": "npm run build && npm run test",
    "sync:icons": "node scripts/sync-icons.ts",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "svgstore": "^3.0.1"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@tabler/icons": "^3.48.0",
    "@tabler/icons-react": "^3.48.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.48.0",
    "lucide-static": "^1.48.0",
    "react": "^19.3.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
